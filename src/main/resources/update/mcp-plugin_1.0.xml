<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!--
      Storage for OAuth grants issued by this plugin.

      Three tables rather than one, because the three objects have different
      lifetimes and different revocation semantics. A grant is what the user
      consented to and outlives both credential types; a code lives for a
      minute and is consumed once; an access token lives for an hour and
      there may be several per grant.

      Liquibase rather than hand-written DDL so the same changelog produces
      correct types on H2 and PostgreSQL, which are the two backends GitBucket
      deployments actually use.
    -->

    <changeSet id="1" author="gitbucket-mcp-plugin">
        <!-- One consent decision: this user, for this client, at this resource. -->
        <createTable tableName="MCP_OAUTH_GRANT">
            <column name="GRANT_ID" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="USER_NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <!-- A client ID metadata document URL; there is no client table. -->
            <column name="CLIENT_ID" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="SCOPES" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="REVOKED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="MCP_OAUTH_GRANT" indexName="IDX_MCP_OAUTH_GRANT_USER">
            <column name="USER_NAME"/>
        </createIndex>

        <!-- Authorization codes. Short-lived, single use, one per authorization. -->
        <createTable tableName="MCP_OAUTH_CODE">
            <column name="CODE_HASH" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="GRANT_ID" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <!-- PKCE S256 challenge, bound at authorization, checked at exchange. -->
            <column name="CODE_CHALLENGE" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <!-- The exact redirect URI sent to /authorize, re-checked at /token. -->
            <column name="REDIRECT_URI" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRES_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="CONSUMED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="MCP_OAUTH_CODE" indexName="IDX_MCP_OAUTH_CODE_GRANT">
            <column name="GRANT_ID"/>
        </createIndex>

        <!--
          Refresh tokens, as a chain rather than a column on the grant.

          A superseded token has to leave a trace: replay detection is the
          whole reason rotation is worth doing, and a grant that only
          remembers its current refresh hash cannot tell a replayed old token
          from a string that was never issued. Each rotation marks its row
          and inserts the successor, so every token this grant ever had is
          still recognisable.
        -->
        <createTable tableName="MCP_OAUTH_REFRESH">
            <column name="TOKEN_HASH" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="GRANT_ID" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRES_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <!-- True once this token has been exchanged for its successor. -->
            <column name="ROTATED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="MCP_OAUTH_REFRESH" indexName="IDX_MCP_OAUTH_REFRESH_GRANT">
            <column name="GRANT_ID"/>
        </createIndex>

        <!-- Access tokens. Opaque, stored hashed, several may exist per grant. -->
        <createTable tableName="MCP_OAUTH_TOKEN">
            <column name="TOKEN_HASH" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="GRANT_ID" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRES_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="MCP_OAUTH_TOKEN" indexName="IDX_MCP_OAUTH_TOKEN_GRANT">
            <column name="GRANT_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
